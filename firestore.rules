rules_version = '2';

// 弓道帳 — Firestore セキュリティルール
//
// 方針：
// - 未ログインはすべて不可。
// - users は本人のみ書き込み可。読み取りは本人＋同じチームのメンバーまで
//   （リーダーがメンバー一覧と名前・学年を見るため）。
// - teams はログイン済みなら読み取り可（招待コードでチームを探すために必要。
//   招待コード自体が参加の鍵になる）。作成は作成者＝リーダーのときのみ、
//   更新・削除はリーダーのみ。
// - practices は本人のみ書き込み可（例外として、リーダーは記録の持ち主の付け替え＝
//   引き継ぎだけ可、削除は整理のためにリーダーも可）。読み取りは同じチームの所属メンバーまで許可する。
//   これは「リーダーがメンバーの詳細（1立ごとの記録・メモ・矢所）を見る」ことと、
//   「一般メンバーがチーム合計を計算する」ことの両立のため。
//   一般メンバーに他人の詳細を見せない出し分けは、アプリ画面側でも行っている
//   （一般メンバーの画面には合計だけを出し、詳細は描画しない）。
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 自分の users ドキュメントにある所属チームID
    // 指定したチームのリーダーかどうか
    function isLeaderOf(teamId) {
      return teamId != null
        && get(/databases/$(database)/documents/teams/$(teamId)).data.leaderUid == request.auth.uid;
    }

    // リーダーがメンバーの名前・学年だけを直す更新かどうか
    // （チーム・役割・ログインIDは変えられない）
    // email は、ある場合だけ「変わっていないこと」を確認する
    // （2026-11-05以降の登録ではプロフィールに email を保存しないため）
    function leaderProfileEdit() {
      return resource.data.teamId != null
        && isLeaderOf(resource.data.teamId)
        && request.resource.data.teamId == resource.data.teamId
        && request.resource.data.role == resource.data.role
        && request.resource.data.loginId == resource.data.loginId
        && request.resource.data.get('email', null) == resource.data.get('email', null);
    }

    // リーダーがメンバーをチームから外す更新かどうか
    // （チームと役割を空にすることだけを許可し、名前など他は変えられない）
    function leaderRemoveMember() {
      return resource.data.teamId != null
        && isLeaderOf(resource.data.teamId)
        && request.resource.data.teamId == null
        && request.resource.data.role == null
        && request.resource.data.loginId == resource.data.loginId
        && request.resource.data.get('email', null) == resource.data.get('email', null)
        && request.resource.data.name == resource.data.name;
    }

    function myTeamId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.teamId;
    }

    // リーダーがメンバーの記録を、同じチームの別メンバーへ引き継ぐ更新かどうか
    // （変えられるのは記録の持ち主 uid だけで、引き継ぎ先も同じチームのメンバーに限る）
    function leaderTransferPractice() {
      return resource.data.teamId != null
        && isLeaderOf(resource.data.teamId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uid'])
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.teamId == resource.data.teamId;
    }

    match /users/{uid} {
      allow read: if signedIn()
        && (request.auth.uid == uid
            || (resource.data.teamId != null && resource.data.teamId == myTeamId()));
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && (request.auth.uid == uid || leaderProfileEdit() || leaderRemoveMember());
      allow delete: if false;
    }

    // ログインID（英数字）→ アカウントの対応表。
    // ログイン前の画面で ID からメールアドレスを引く必要があるため、
    // 1件だけの読み取り（get）はログイン前でも許可する。一覧表示（list）は不可。
    // 作成は本人のみ（自分の uid と、認証に登録されたメールアドレスだけ書ける）。
    match /usernames/{loginId} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if false;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.leaderUid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.leaderUid == request.auth.uid;
    }

    match /practices/{practiceId} {
      allow read: if signedIn()
        && (resource.data.uid == request.auth.uid
            || resource.data.teamId == myTeamId());
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.uid == request.auth.uid || leaderTransferPractice());
      // 削除は本人に加えて、そのチームのリーダーも可
      // （3年より前の記録をまとめて整理するため）
      allow delete: if signedIn()
        && (resource.data.uid == request.auth.uid || isLeaderOf(resource.data.teamId));
    }
  }
}
